  - {fileID: 5400000000000000299}
  - {fileID: 5400000000000000326}
  - {fileID: 5400000000000000353}
  _remarkText: {fileID: 5400000000000000365}
  _diedRemarks:
  - "\uC0AC\uC778 : \uC815\uB839\uACFC\uC758 \uAD50\uC804 \uC911 \uC18C\uC2E4.\n\uC794\uD574
    \uD68C\uC218 \uBD88\uAC00. \uB2E4\uC74C \uAC1C\uCCB4\uB97C \uD22C\uC785\uD55C\uB2E4."
  - "\uC0AC\uC778 : \uC624\uC5FC\uB41C \uC815\uB839\uC758 \uC9D1\uC911 \uACF5\uACA9.\n\uC794\uD574
    \uD68C\uC218 \uBD88\uAC00. \uB2E4\uC74C \uAC1C\uCCB4\uB97C \uD22C\uC785\uD55C\uB2E4."
  - "\uC0AC\uC778 : \uACFC\uB3C4\uD55C \uC190\uC0C1\uC73C\uB85C \uD615\uCCB4 \uBD95\uAD34.\n\uC794\uD574
    \uD68C\uC218 \uBD88\uAC00. \uB2E4\uC74C \uAC1C\uCCB4\uB97C \uD22C\uC785\uD55C\uB2E4."
  _missionFailedRemarks:
  - "\uC784\uBB34 \uC2DC\uD55C \uCD08\uACFC. \uAC1C\uCCB4\uAC00 \uC624\uC5FC\uC5D0 \uC7A0\uC2DD\uB428.\n\uC794\uD574 \uD68C\uC218 \uBD88\uAC00. \uD574\uB2F9 \uAD6C\uC5ED \uC811\uADFC \uAE08\uC9C0."
  _abandonedRemarks:
  - "\uC870\uC0AC \uC911\uB2E8 \uC694\uCCAD\uC5D0 \uB530\uB77C \uAC1C\uCCB4\uB97C \uD68C\uC218\uD568.\n\uC7A5\uCC29 \uB8EC\uC740 \uD68C\uC218 \uACFC\uC815\uC5D0\uC11C \uC18C\uC2E4\uB418\uC5C8\uB2E4."
  _clearedRemarks:
  - "\uCD5C\uC2EC\uBD80\uC758 \uC218\uD638\uC790 \uC18C\uBA78 \uD655\uC778.\n\uC815\uB839\uACC4
    \uC624\uC5FC\uC758 \uADFC\uC6D0\uC774 \uC815\uD654\uB418\uC5C8\uB2E4."
  _stampImage: {fileID: 5400000000000000377}
  _diedStamp: {fileID: 21300000, guid: 39af3764c6634f039353324371f7a366, type: 3}
  _missionFailedStamp: {fileID: 21300000, guid: 8de7b8063a9b4684aa6f7b3e2163834d, type: 3}
  _abandonedStamp: {fileID: 21300000, guid: ccea41e8784f4d198a767c439b768287, type: 3}
  _clearedStamp: {fileID: 21300000, guid: 8dca8da9a238416fa1536e731d04ddbe, type: 3}
  _titleText: {fileID: 5400000000000000388}
  _subtitleText: {fileID: 5400000000000000392}
  _titleGlow: {fileID: 5400000000000000384}
  _diedTitle: "\uD0D0\uC0AC \uC885\uB8CC"
  _missionFailedTitle: "\uAC1C\uCCB4 \uC7A0\uC2DD"
  _abandonedTitle: "\uD0D0\uC0AC \uC911\uB2E8"
  _clearedTitle: "\uC815\uB839\uACC4 \uC815\uD654"
  _diedSubtitle: "\uD638\uBB38\uCFE8\uB8E8\uC2A4 \uC81C {0}\uD638\uC758 \uAE30\uB85D\uC774
    \uD611\uD68C\uC5D0 \uC81C\uCD9C\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
  _missionFailedSubtitle: "\uD638\uBB38\uCFE8\uB8E8\uC2A4 \uC81C {0}\uD638\uC758 \uAE30\uB85D\uC774 \uC624\uC5FC\uB41C \uCC44 \uD68C\uC218\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
  _abandonedSubtitle: "\uD638\uBB38\uCFE8\uB8E8\uC2A4 \uC81C {0}\uD638\uAC00 \uD611\uD68C\uB85C \uD68C\uC218\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
