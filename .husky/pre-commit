#!/bin/sh

SCRIPT_DIR="Assets/01_Scripts"

echo "Running pre-commit checks..."

# ------------------------------------------------------------
# 1. Staged C# 파일 조회
# ------------------------------------------------------------

CS_FILES=$(
    git diff --cached \
        --name-only \
        --diff-filter=ACMR \
        -- "$SCRIPT_DIR" |
    grep '\.cs$'
)

if [ -z "$CS_FILES" ]; then
    echo ""
    echo "$SCRIPT_DIR 폴더에 검사할 C# 파일이 없습니다."
    echo "Pre-commit checks passed."
    exit 0
fi

echo ""
echo "Staged C# files:"
echo "$CS_FILES"


# ------------------------------------------------------------
# 2. C# 이름 규칙 검사
# ------------------------------------------------------------

echo ""
echo "Checking C# naming..."

if ! dotnet format style Assembly-CSharp.csproj \
    --verify-no-changes \
    --severity info \
    --diagnostics IDE1006 \
    --include $CS_FILES; then

    echo ""
    echo "C# 이름 규칙 검사를 통과하지 못했습니다."
    echo "수정된 파일을 다시 stage한 뒤 커밋해주세요."
    exit 1
fi

echo "C# naming check passed."

echo ""
echo "Pre-commit checks passed."

exit 0
